# Copy this file to terraform.tfvars and fill in your values

# AWS Configuration
aws_region = "us-east-1"

# Project Configuration
project_name = "n8n-deployment"
environment  = "production"

# SSH Configuration (optional - you can use SSM instead)
create_ssh_key = false  # Set to true if you want SSH access
# ssh_public_key_content = "ssh-rsa AAAAB3NzaC1yc2EAAAA... your-email@example.com"

# Cost Optimization Settings
single_az_deployment = true   # Deploy in single AZ to reduce costs

# n8n Configuration
n8n_encryption_key = "your-32-character-encryption-key-here"